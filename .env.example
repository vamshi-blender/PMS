# Server-only OpenAI credentials. Never expose these to the extension.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Separate stateless model used to name new conversations.
OPENAI_TITLE_MODEL=gpt-5.6-luna

# Every API route requires the caller's PMS access token, which the server
# confirms with PMS (see lib/http/auth.ts). The extension sends it for you.
#
# Optional local-testing bypass: when set, `Authorization: Bearer <this key>`
# is accepted instead of a PMS token, so the API can be called with curl or
# scripts. Use a long random value (32+ characters; shorter keys are ignored),
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Set it only in .env.local. Leave it unset on Vercel: it is ignored on
# production deployments anyway, and anyone holding it can use the AI.
DONNA_DEV_API_KEY=5997263e5ae0f2a86da2911cea43737f6f51549168d5e988f61079051b50634e

# SECURITY: ALLOWED_EXTENSION_ORIGINS and ENABLE_PRODUCTION_CHAT were removed
# in the commit that relaxed security for development. CORS is open to all
# origins (see lib/http/cors.ts) and there is no production kill-switch or
# rate limiting. See that commit to bring them back.
